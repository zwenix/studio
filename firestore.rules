// Forcing a full backend and rules redeployment to resolve silent publishing failure and dependency drift.
/**
 * Core Philosophy: This ruleset enforces a role-based and ownership-driven security model
 * for the EduAI Companion platform. Data access is strictly controlled based on the
 * authenticated user's role (teacher, learner, parent, admin) and their direct relationship to the data.
 *
 * Data Structure: The data is organized into top-level collections representing distinct
 * entity types: `users`, `learners`, `teachers`, `parents`, `content`, `classes`, and `conversations`.
 * This segregation provides clear boundaries for security rules. User-specific profiles are kept
 * separate from collaborative data like `classes` and `conversations`.
 *
 * Key Security Decisions:
 * - Strict User Ownership: All personal profile documents (in `/users`, `/learners`, etc.)
 *   can only be read or written by the owner of that document, unless the user is an admin.
 * - Secure Collaboration: Access to shared documents like `/classes` and `conversations`
 *   is governed by denormalized member lists (`teacherId`, `learnerIds`, `participantIds`)
 *   on the document itself. This avoids slow and costly `get` calls in subcollection rules.
 * - Secure Listing: `list` operations are secured by enforcing query constraints (e.g., `array-contains`)
 *   that ensure a user can only retrieve documents they are a member of.
 *
 * Denormalization for Authorization: To create performant and secure rules, authorization data
 * is denormalized. For example, `classes` documents contain `learnerIds` and `parentIds`, and
 * `conversations` documents contain `participantIds`. This allows rules to grant access
 * without needing to read other documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for reusable logic
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTeacher() {
      return isSignedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function documentExists() {
      return resource != null;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && documentExists();
    }

    // Checks if the user is the teacher of the specified class.
    function isClassTeacher(classId) {
      let classDoc = get(/databases/$(database)/documents/classes/$(classId));
      return isSignedIn() && classDoc.data.teacherId == request.auth.uid;
    }

    // Checks if the user is a parent of a student enrolled in the class.
    function isParentOfEnrolledStudent(classId) {
      let classDoc = get(/databases/$(database)/documents/classes/$(classId));
      return classDoc.data.parentIds != null && request.auth.uid in classDoc.data.parentIds;
    }


    /**
     * @description Secures user profiles. A user can manage their own profile. A teacher or admin can read any user profile. Admin can write.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isTeacher() || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }
    
    /**
     * @description Allows teachers and admins to list users to find students to add to their class.
     * @path /users
     */
    match /users/{path=**} {
      allow list: if isTeacher() || isAdmin();
    }


    /**
     * @description Secures learner profiles. The user or a teacher/admin can read it, but only the user or admin can write.
     * @path /learners/{learnerId}
     */
    match /learners/{learnerId} {
      allow get: if isOwner(learnerId) || isTeacher() || isAdmin();
      allow write: if isOwner(learnerId) || isAdmin();
    }

    /**
     * @description Secures teacher profiles. Only the associated user or an admin can access their own teacher document.
     * @path /teachers/{teacherId}
     */
    match /teachers/{teacherId} {
      allow read, write: if isOwner(teacherId) || isAdmin();

      /**
       * @description Secures a teacher's history of generated content. Only the teacher or admin can manage their own content.
       * @path /teachers/{teacherId}/generatedContent/{contentId}
       */
      match /generatedContent/{contentId} {
        allow read, write: if isOwner(teacherId) || isAdmin();
      }
    }

    /**
     * @description Secures parent profiles. Only the associated user or an admin can access their own parent document.
     * @path /parents/{parentId}
     */
    match /parents/{parentId} {
      allow read, write: if isOwner(parentId) || isAdmin();
    }

    /**
     * @description Allows public read access to content, but write access is restricted to the creating teacher or an admin.
     * @path /content/{contentId}
     */
    match /content/{contentId} {
      allow get, list: if true;
      allow create: if (isSignedIn() && request.resource.data.teacherId == request.auth.uid) || isAdmin();
      allow update: if isExistingOwner(resource.data.teacherId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.teacherId) || isAdmin();
    }

    /**
     * @description Secures class documents. The teacher or admin can manage it, and enrolled members can read it.
     * @path /classes/{classId}
     */
    match /classes/{classId} {
      allow get: if isSignedIn() && (resource.data.teacherId == request.auth.uid || request.auth.uid in resource.data.learnerIds || isParentOfEnrolledStudent(classId) || isAdmin());
      allow list: if isSignedIn();
      allow create: if (isSignedIn() && request.resource.data.teacherId == request.auth.uid) || isAdmin();
      allow update: if isExistingOwner(resource.data.teacherId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.teacherId) || isAdmin();

      /**
       * @description Secures assignments within a class. The class teacher or admin has full control. The assigned learner can read and submit their work.
       * @path /classes/{classId}/assignments/{assignmentId}
       */
      match /assignments/{assignmentId} {
        allow get: if isSignedIn() && (isClassTeacher(classId) || isOwner(resource.data.learnerId) || isParentOfEnrolledStudent(classId) || isAdmin());
        allow list: if isSignedIn() && (isClassTeacher(classId) || request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.learnerIds || isParentOfEnrolledStudent(classId) || isAdmin());
        allow create: if (isClassTeacher(classId) && request.resource.data.learnerId in get(/databases/$(database)/documents/classes/$(classId)).data.learnerIds) || isAdmin();
        allow update: if ((isClassTeacher(classId) || isOwner(resource.data.learnerId)) && documentExists()) || isAdmin();
        allow delete: if (isClassTeacher(classId) && documentExists()) || isAdmin();
      }
    }
    
    /**
     * @description Secures conversation documents. Only participants can read, write, or list them.
     * @path /conversations/{conversationId}
     */
    match /conversations/{conversationId} {
      // A user can read or list conversations they are a participant in.
      // The rule is defensive, checking that participantIds exists and is a list.
      // The `list` operation is secured by a required `array-contains` query on the client.
      allow get, list: if isSignedIn() 
                       && 'participantIds' in resource.data 
                       && resource.data.participantIds is list 
                       && request.auth.uid in resource.data.participantIds;
      
      // A user can create a conversation if they are one of the participants.
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      
      // A user can update a conversation (e.g., the lastMessage field) if they are a participant.
      allow update: if isSignedIn() 
                    && 'participantIds' in resource.data 
                    && resource.data.participantIds is list 
                    && request.auth.uid in resource.data.participantIds;

      /**
       * @description Secures messages within a conversation.
       * @path /conversations/{conversationId}/messages/{messageId}
       */
      match /messages/{messageId} {
        // A user can read messages in a conversation they are a part of.
        allow get, list: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        
        // A user can create a message if they are a participant and the sender.
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
