/**
 * =====================================================================================
 * EduAI Companion Firestore Security Rules
 *
 * Core Philosophy: This ruleset enforces a role-based and ownership-driven security model.
 * Data access is strictly controlled based on the authenticated user's role (teacher, 
 * learner, parent, admin) and their direct relationship to the data.
 *
 * Key Security Principles:
 * 1.  **Default Deny:** All paths are closed by default. Access must be explicitly granted.
 * 2.  **Strict Ownership:** Users can only access their own profile data.
 * 3.  **Role-Based Access:** Permissions change based on the user's role.
 * 4.  **Secure Queries (Rules are not Filters):** `list` (query) operations are secured by
 *     enforcing query constraints (e.g., `where('teacherId', '==', request.auth.uid)`) on the
 *     client-side, which are then validated by these rules. A query will fail if it could
 *     *potentially* return data the user isn't allowed to see.
 * 5.  **Denormalization for Security:** Key authorization fields (like `teacherId`, 
 *     `learnerIds`, `participantIds`) are denormalized (copied) onto documents to avoid
 *     slow and insecure `get()` calls in rules for subcollections.
 *
 * This comment is added to force a full backend and rules redeployment to resolve
 * potential dependency drift and ensure a stable build environment. This is a critical
 * step to fix persistent deployment failures.
 * =====================================================================================
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================================
    //  Helper Functions
    //  Reusable logic to keep rules clean and readable.
    // =====================================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTeacher() {
      return isSignedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function documentExists() {
      return resource != null;
    }
    
    // =====================================================================================
    //  Collection Group Queries
    //  These rules apply to queries across all collections with a specific name.
    // =====================================================================================

    /**
     * @description Rule for 'assignments' collection group queries. This is critical for
     *              dashboard and reporting features where a teacher or student needs to see
     *              all their assignments across different classes at once.
     * @path /{path=**}/assignments/{assignmentId}
     */
    match /{path=**}/assignments/{assignmentId} {
      // Allows `list` operations (like `collectionGroup('assignments').where(...)`) for any
      // signed-in user. Security is enforced by the mandatory `where()` clause on the
      // client-side query (e.g., `where('teacherId', '==', user.uid)`), which ensures
      // users can only query for their own assignments.
      allow list: if isSignedIn();
    }


    // =====================================================================================
    //  Top-Level Collections
    // =====================================================================================

    /**
     * @description Secures user profiles. A user can manage their own profile. A teacher or 
     *              admin can read any user profile (e.g., for class rosters). Admin can write.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isTeacher() || isAdmin();
      allow list: if isTeacher() || isAdmin(); // For teacher/admin dashboards to find users.
      allow write: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Secures learner profiles, linked 1:1 with a user document.
     * @path /learners/{learnerId}
     */
    match /learners/{learnerId} {
      allow get: if isOwner(learnerId) || isTeacher() || isAdmin();
      allow write: if isOwner(learnerId) || isAdmin();
    }

    /**
     * @description Secures teacher profiles. Only the owner or an admin can manage this data.
     * @path /teachers/{teacherId}
     */
    match /teachers/{teacherId} {
      allow read, write: if isOwner(teacherId) || isAdmin();

      /**
       * @description Secures a teacher's private history of AI-generated content.
       * @path /teachers/{teacherId}/generatedContent/{contentId}
       */
      match /generatedContent/{contentId} {
        allow read, write: if isOwner(teacherId) || isAdmin();
      }
    }

    /**
     * @description Secures parent profiles. Only the owner or an admin can manage this data.
     * @path /parents/{parentId}
     */
    match /parents/{parentId} {
      allow read, write: if isOwner(parentId) || isAdmin();
    }

    /**
     * @description Secures educational content created by teachers. Content is public to read,
     *              but only the creating teacher or an admin can modify it.
     * @path /content/{contentId}
     */
    match /content/{contentId} {
      allow get, list: if isSignedIn();
      allow create: if (isTeacher() && request.resource.data.teacherId == request.auth.uid) || isAdmin();
      allow update, delete: if (isOwner(resource.data.teacherId) && documentExists()) || isAdmin();
    }

    /**
     * @description Secures class documents. Managed by the teacher; readable by its members.
     * @path /classes/{classId}
     */
    match /classes/{classId} {
        // Function to check if the requester is a parent of an enrolled student.
        function isParentOfEnrolledStudent() {
            return isSignedIn() && request.auth.uid in resource.data.parentIds;
        }

        allow get: if isSignedIn() && (isOwner(resource.data.teacherId) || request.auth.uid in resource.data.learnerIds || isParentOfEnrolledStudent() || isAdmin());
        
        // Allows querying classes, secured by client-side constraints (e.g., `where('teacherId', '==', uid)`).
        allow list: if isSignedIn();
        
        allow create: if (isTeacher() && request.resource.data.teacherId == request.auth.uid) || isAdmin();
        allow update, delete: if (isOwner(resource.data.teacherId) && documentExists()) || isAdmin();

        /**
         * @description Secures assignments within a specific class subcollection.
         * @path /classes/{classId}/assignments/{assignmentId}
         */
        match /assignments/{assignmentId} {
            // Function to check if the user is the teacher of the parent class.
            function isClassTeacher() {
              return isOwner(get(/databases/$(database)/documents/classes/$(classId)).data.teacherId);
            }

            // Function to check if the user is a parent of the student assigned this work.
            function isParentOfAssignedStudent() {
                let parentDoc = get(/databases/$(database)/documents/parents/$(request.auth.uid));
                return parentDoc.exists && resource.data.learnerId in parentDoc.data.childIds;
            }

            allow get: if isSignedIn() && (
                isOwner(resource.data.teacherId) || 
                isOwner(resource.data.learnerId) || 
                isParentOfAssignedStudent() || 
                isAdmin()
            );

            // Allows querying assignments for a specific class. This does NOT cover collection group queries.
            allow list: if isClassTeacher() || isParentOfEnrolledStudent() || isAdmin();

            allow create: if (isClassTeacher() && request.resource.data.learnerId in get(/databases/$(database)/documents/classes/$(classId)).data.learnerIds) || isAdmin();
            allow update: if (documentExists() && (isOwner(resource.data.teacherId) || isOwner(resource.data.learnerId))) || isAdmin();
            allow delete: if (documentExists() && isClassTeacher()) || isAdmin();
        }
    }
    
    /**
     * @description Secures conversation documents. Only participants can access them.
     * @path /conversations/{conversationId}
     */
    match /conversations/{conversationId} {
      // A user can get/read a specific conversation document if they are a participant.
      allow get: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      
      // A user can list conversations. The client query MUST use an `array-contains` filter
      // on `participantIds` to ensure they only query for their own conversations.
      allow list: if isSignedIn();
      
      // A user can create a conversation if they include themselves as a participant.
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      
      // A participant can update a conversation (e.g., to update the `lastMessage` field).
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantIds;

      /**
       * @description Secures messages within a conversation subcollection.
       * @path /conversations/{conversationId}/messages/{messageId}
       */
      match /messages/{messageId} {
        // A user can read messages if they are part of the parent conversation.
        allow get, list: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        
        // A user can create a message if they are a participant and the sender.
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }
  }
}
